<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>TOW2SkillEditor</RootNamespace>
    <AssemblyName>TOW2SkillEditor</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- unpackaged: plain .exe, no MSIX -->
    <WindowsPackageType>None</WindowsPackageType>
    <!-- bundle the Windows App SDK so no runtime install is needed -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <!--
    `dotnet publish` does not carry the app's own compiled XAML (.xbf) or its resource
    index (.pri) into the publish folder, though `dotnet build` emits them correctly.
    Without them XAML cannot resolve and the app dies at startup with a stowed
    exception (0xC000027B, E_FAIL in Microsoft.UI.Xaml.dll). Copy them explicitly.
  -->
  <Target Name="IncludeXamlArtifactsInPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_XamlArtifact Include="$(OutputPath)*.xbf" />
      <_XamlArtifact Include="$(OutputPath)$(AssemblyName).pri" />
      <ResolvedFileToPublish Include="@(_XamlArtifact)"
                             RelativePath="%(Filename)%(Extension)"
                             CopyToPublishDirectory="Always" />
    </ItemGroup>
  </Target>

</Project>
