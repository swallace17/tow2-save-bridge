<Application
    x:Class="TOW2SkillEditor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- amber accent, so the app reads as its own thing rather than system default -->
            <Color x:Key="Amber">#E0932E</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Amber}" />

            <x:Double x:Key="MonoSize">13</x:Double>
            <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

            <Style x:Key="Eyebrow" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="120" />
                <Setter Property="Opacity" Value="0.65" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
