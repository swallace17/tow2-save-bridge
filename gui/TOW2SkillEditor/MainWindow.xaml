<Window
    x:Class="TOW2SkillEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Outer Worlds 2 Skill Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- title bar strip -->
        <Grid x:Name="AppTitleBar" Height="44" Grid.Row="0" Padding="16,0">
            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       Text="Outer Worlds 2 &#8212; Skill Editor" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="264,*" Padding="16,4,16,0" ColumnSpacing="18">

            <!-- ============ saves ============ -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="SAVES" Style="{StaticResource Eyebrow}" Margin="4,0,0,8" />
                <ListView x:Name="SaveList" Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="SaveList_SelectionChanged"
                          CornerRadius="8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Padding" Value="10,4" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Spacing="0">
                                <TextBlock Text="{Binding Character}" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Opacity="0.55"
                                           FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ============ editor ============ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,Auto,*">

                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,0,0,14">
                    <TextBlock Grid.Column="0" Text="NAME" Style="{StaticResource Eyebrow}"
                               VerticalAlignment="Center" />
                    <TextBox x:Name="NameBox" Grid.Column="1" Height="32" MaxLength="40"
                             PlaceholderText="Name shown in the load list" />
                </Grid>

                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="4,0,0,8">
                    <TextBlock Grid.Column="0" Text="SKILLS" Style="{StaticResource Eyebrow}" />
                    <!-- record location: a readout, not an alert, so no InfoBar chrome -->
                    <TextBlock x:Name="RecordInfo" Grid.Column="2" Style="{StaticResource Eyebrow}"
                               Opacity="0.4" ToolTipService.ToolTip="Where the skill array was found inside the save: chunk magic, byte offset of the record in the inflated payload, and its payload size." />
                </Grid>

                <!-- only appears when something actually happened -->
                <InfoBar x:Name="Status" Grid.Row="2" IsOpen="False" IsClosable="False"
                         Margin="0,0,0,12" CornerRadius="8" />

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <ItemsRepeater x:Name="SkillItems">
                            <ItemsRepeater.Layout>
                                <!-- capped at 2 so a maximized window doesn't sprawl to 3-4 columns -->
                                <UniformGridLayout MinItemWidth="236" MinItemHeight="34"
                                                   MaximumRowsOrColumns="2" Orientation="Horizontal"
                                                   MinColumnSpacing="24" MinRowSpacing="2" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,Auto,88" ColumnSpacing="8" Height="32">
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="13"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding OffsetLabel}" FontSize="10.5"
                                                   Opacity="0.38" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource MonoFont}" />
                                        <NumberBox Grid.Column="2"
                                                   Value="{Binding Value, Mode=TwoWay}"
                                                   Minimum="0" Maximum="999"
                                                   Height="30" VerticalAlignment="Center"
                                                   SpinButtonPlacementMode="Compact"
                                                   SmallChange="1" LargeChange="10" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Margin="0,6,0,2" />

                        <Grid ColumnDefinitions="*,Auto,88" ColumnSpacing="8" Height="32">
                            <TextBlock Grid.Column="0" Text="Points Available" FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="+337" FontSize="10.5" Opacity="0.38"
                                       VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}" />
                            <NumberBox x:Name="PointsBox" Grid.Column="2" Minimum="0" Maximum="255"
                                       Height="30" VerticalAlignment="Center"
                                       SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Opacity="0.5" Margin="0,2,0,0"
                                   Text="Values are the stored base. Tagged skills display 2 higher in game &#8212; write your target minus 2 for those." />

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ action bar ============ -->
        <Grid Grid.Row="2" Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <CheckBox x:Name="CloneFirst" Grid.Column="0" VerticalAlignment="Center" IsChecked="True"
                      Content="Edit a copy, leaving the original untouched" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReloadBtn" Content="Reload" Click="Reload_Click" />
                <Button x:Name="ApplyBtn" Content="Apply changes" Click="Apply_Click"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
