<Window
    x:Class="TOW2SkillEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Outer Worlds 2 Skill Editor">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- title bar strip -->
        <Grid x:Name="AppTitleBar" Height="44" Grid.Row="0" Padding="16,0">
            <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       Text="Outer Worlds 2 &#8212; Skill Editor" />
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="320,*" Padding="16,4,16,0" ColumnSpacing="16">

            <!-- ============ saves ============ -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="SAVES" Style="{StaticResource Eyebrow}" Margin="4,0,0,8" />
                <ListView x:Name="SaveList" Grid.Row="1"
                          SelectionMode="Single"
                          SelectionChanged="SaveList_SelectionChanged"
                          CornerRadius="8"
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Padding="4,8" Spacing="2">
                                <TextBlock Text="{Binding Character}" FontWeight="SemiBold" FontSize="13.5" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Opacity="0.6"
                                           FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- ============ editor ============ -->
            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">

                <TextBlock Grid.Row="0" Text="SKILLS" Style="{StaticResource Eyebrow}" Margin="4,0,0,8" />

                <InfoBar x:Name="Status" Grid.Row="1" IsOpen="False" IsClosable="False"
                         Margin="0,0,0,12" CornerRadius="8" />

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <ItemsRepeater x:Name="SkillItems">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="270" MinItemHeight="56"
                                                   MinColumnSpacing="16" MinRowSpacing="6" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="*,124" ColumnSpacing="12">
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" />
                                            <TextBlock Text="{Binding OffsetLabel}" FontSize="10.5" Opacity="0.45"
                                                       FontFamily="{StaticResource MonoFont}" />
                                        </StackPanel>
                                        <NumberBox Grid.Column="1"
                                                   Value="{Binding Value, Mode=TwoWay}"
                                                   Minimum="0" Maximum="999"
                                                   SpinButtonPlacementMode="Compact"
                                                   SmallChange="1" LargeChange="10" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>

                        <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                Margin="0,4,12,4" />

                        <Grid ColumnDefinitions="*,132" ColumnSpacing="12" Margin="0,0,12,0">
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="Points Available" FontSize="13.5" FontWeight="SemiBold" />
                                <TextBlock Text="payload +337 &#183; u8" FontSize="10.5" Opacity="0.45"
                                           FontFamily="{StaticResource MonoFont}" />
                            </StackPanel>
                            <NumberBox x:Name="PointsBox" Grid.Column="1" Minimum="0" Maximum="255"
                                       SpinButtonPlacementMode="Compact" SmallChange="1" LargeChange="5" />
                        </Grid>

                        <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.55" Margin="0,4,12,0"
                                   Text="Values are the stored base. Tagged skills (starred in game) display 2 higher, so write your target minus 2 for those." />

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ action bar ============ -->
        <Grid Grid.Row="2" Padding="16" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <CheckBox x:Name="CloneFirst" Grid.Column="0" VerticalAlignment="Center" IsChecked="True"
                      Content="Edit a copy, leaving the original untouched" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button x:Name="ReloadBtn" Content="Reload" Click="Reload_Click" />
                <Button x:Name="ApplyBtn" Content="Apply changes" Click="Apply_Click"
                        Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>
